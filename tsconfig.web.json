{
  // Renderer side: the screen and the panel. No Node types here, so screen code that
  // reaches for fs / process / electron fails to compile.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    // The panel is Preact; themes stay plain TS and never use JSX.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo"
  },
  "include": ["contract", "screen", "cmd/screen", "panel", "cmd/panel"]
}
