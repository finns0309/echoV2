{
  "name": "echo-v2",
  "productName": "Echo",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop display that agents and sources feed; lyrics are just one content pack.",
  "author": "Finn",
  "type": "module",
  "main": "out/main/main.js",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsup && pnpm build:native",
    "build:native": "mkdir -p out/native && swiftc -O native/hotkey/main.swift -o out/native/echo-hotkey",
    "preview": "electron-vite preview",
    "build:mcp": "tsup",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "icon": "swift scripts/make-icon.swift",
    "package": "pnpm build && electron-builder --mac"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@modelcontextprotocol/sdk": "^1.30",
    "@preact/signals": "^2.11.2",
    "@types/node": "^24",
    "electron": "^44",
    "electron-builder": "^26",
    "electron-vite": "^5",
    "eslint": "^10",
    "globals": "^17.12.0",
    "preact": "^10.29.8",
    "tsup": "^8.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70",
    "vite": "^7",
    "vitest": "^5",
    "zod": "^4"
  },
  "build": {
    "appId": "com.finn.echo",
    "productName": "Echo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "assets/trayTemplate*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/mcp/mcp.js",
        "to": "mcp.js"
      },
      {
        "from": "out/native/echo-hotkey",
        "to": "echo-hotkey"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Echo"
    },
    "afterSign": "scripts/sign.cjs"
  }
}
