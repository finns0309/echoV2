{
  // Node side: the display server, its entry points, and the tooling.
  // No DOM types here, so server code that reaches for the DOM fails to compile.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "contract",
    "server",
    "cmd/display",
    "cmd/mcp",
    "architecture",
    "screen/themes/*/manifest.ts",
    "screen/themes/*/grammar.ts",
    "*.config.ts"
  ]
}
